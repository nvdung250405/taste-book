{
  "name": "tastebook_be",
  "version": "1.0.0",
  "description": "tastebook_backend",
  "license": "ISC",
  "author": "hiusmall",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "test:auth": "npx newman run postman/tastebook_auth_postman_collection_v2.json -e postman/tastebook_environment.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/auth-report.html",
    "test:user": "npx newman run postman/tastebook_user_profile_postman_collection_v2.json -e postman/tastebook_environment.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/user-report.html",
    "test:recipes": "npx newman run postman/tastebook_recipes_postman_collection.json -e postman/tastebook_environment.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/recipes-report.html",
    "test:api": "npm run test:auth && npm run test:user && npm run test:recipes",
    "start": "nodemon --exec babel-node src/server.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:setup": "npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "db:reset": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/node": "^7.23.9",
    "@babel/preset-env": "^7.24.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.2"
  }
}
