  "item": [
    {
      "name": "0. Đăng nhập chuẩn bị Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('0. Đăng nhập thành công lấy token', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.DT).to.have.property('accessToken');",
              "    pm.collectionVariables.set('accessToken', jsonData.DT.accessToken);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"valueLogin\": \"chef.quocanh@tastebook.vn\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "0b Ngoại lệ: Lấy hồ sơ khi không có Token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.cookies.jar().clear(pm.collectionVariables.get('baseUrl'), function () {});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('0b Không token -> 401, EC=5', function () {",
              "    pm.expect(pm.response.code).to.eql(401);",
              "    pm.expect(pm.response.json().EC).to.eql(5);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["users", "me"]
        }
      },
      "response": []
    },
    {
      "name": "1. Lấy thông tin hồ sơ cá nhân hiện tại (GET /users/me)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('1. Lấy hồ sơ cá nhân thành công - Status 200 OK', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.EC).to.eql(0);",
              "    pm.expect(jsonData.DT).to.have.property('userId');",
              "    pm.expect(jsonData.DT).to.have.property('username');",
              "    pm.expect(jsonData.DT).to.have.property('email');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
