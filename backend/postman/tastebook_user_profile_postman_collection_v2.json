  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response có cấu trúc EC / EM / DT chuẩn', function () {",
          "    var jsonData;",
          "    pm.expect(function () { jsonData = pm.response.json(); }).to.not.throw();",
          "",
          "    pm.expect(jsonData).to.be.an('object');",
          "    pm.expect(jsonData).to.have.property('EC');",
          "    pm.expect(jsonData).to.have.property('EM');",
          "    pm.expect(jsonData).to.have.property('DT');",
          "",
          "    pm.expect(jsonData.EC).to.be.a('number');",
          "    pm.expect(jsonData.EM).to.be.a('string');",
          "    pm.expect(jsonData.EM.trim()).to.not.eql('');",
          "",
          "    var dtType = jsonData.DT === null",
          "        ? 'null'",
          "        : (Array.isArray(jsonData.DT) ? 'array' : typeof jsonData.DT);",
          "    pm.expect(['null', 'object', 'array']).to.include(dtType);",
          "});",
          "",
          "pm.test('EC phù hợp với HTTP Status theo đặc tả', function () {",
          "    var jsonData = pm.response.json();",
          "    var status = pm.response.code;",
          "    var allowedEC = {",
          "        200: [0],",
          "        201: [0],",
          "        400: [1],",
          "        401: [5, 6],",
          "        403: [4],",
          "        404: [3],",
          "        409: [2],",
          "        500: [-1]",
          "    };",
          "",
          "    if (allowedEC[status]) {",
          "        pm.expect(allowedEC[status]).to.include(jsonData.EC);",
          "    }",
          "});",
          "",
          "pm.test('DT = null đối với response lỗi 4xx/5xx', function () {",
          "    var jsonData = pm.response.json();",
          "    if (pm.response.code >= 400) {",
          "        pm.expect(jsonData.DT).to.eql(null);",
          "    }",
          "});"
        ]
      }
    }
  ]
