  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "currentPassword", "value": "123456", "type": "string" },
    { "key": "originalUsername", "value": "Bếp Trưởng Quốc Anh", "type": "string" }
