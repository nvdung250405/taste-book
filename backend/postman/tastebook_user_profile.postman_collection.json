      "name": "0. Đăng nhập chuẩn bị Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('0. Đăng nhập thành công lấy token', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.DT).to.have.property('accessToken');",
              "    pm.collectionVariables.set('accessToken', jsonData.DT.accessToken);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"valueLogin\": \"chef.hoang@tastebook.vn\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Đăng nhập tài khoản test Bếp Trưởng Hoàng để lấy accessToken."
      },
      "response": []
    },
