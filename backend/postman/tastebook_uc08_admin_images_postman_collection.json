        {
          "name": "PRE-08-01 Tải lên ảnh riêng cho kiểm thử xóa ảnh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = null;",
                  "    try { body = pm.response.json(); } catch (error) { /* Phép kiểm tra cấu trúc phản hồi sẽ báo lỗi nếu JSON không hợp lệ. */ }",
