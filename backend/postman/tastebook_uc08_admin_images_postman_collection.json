  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Đọc cấu hình từ environment Local/Staging đang được chọn.",
          "var environmentKeys = [\"baseUrl\",\"userAEmail\",\"userPassword\",\"adminEmail\",\"adminPassword\",\"maxResponseMs\"];",
          "environmentKeys.forEach(function (key) {",
          "  pm.variables.set(key, pm.environment.get(key));",
          "});",
          "",
          "// Dùng phạm vi cục bộ để environment không ghi đè ID và token của lượt chạy.",
          "      Object.keys(pm.collectionVariables.toObject()).forEach(function (key) {",
          "        if (key.indexOf('tb98') === 0) pm.variables.set(key, pm.collectionVariables.get(key));",
          "      });",
          "// Mỗi request dùng lại ngưỡng environment; chỉ warm-up được nới riêng.",
          "pm.variables.set('tb98ResponseLimitMs', Number(pm.environment.get('maxResponseMs')));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Cấu trúc phản hồi: JSON có đủ EC/EM/DT', function () {",
          "        pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
          "        var data = pm.response.json();",
          "        pm.expect(data).to.be.an('object');",
          "        pm.expect(data).to.have.all.keys('EC', 'EM', 'DT');",
          "        pm.expect(data.EC).to.be.a('number');",
          "        pm.expect(data.EM).to.be.a('string'); pm.expect(data.EM.trim()).not.to.eql('');",
          "        pm.expect(data.DT === null || typeof data.DT === 'object').to.eql(true);",
          "      });",
          "      pm.test('Cấu trúc phản hồi: lỗi không trả dữ liệu', function () {",
          "        if (pm.response.code >= 400) pm.expect(pm.response.json().DT).to.eql(null);",
          "      });",
          "",
          "pm.test('Hiệu năng: thời gian phản hồi nhỏ hơn ngưỡng của request', function () {",
          "  var maxResponseMs = Number(pm.variables.get('tb98ResponseLimitMs'));",
          "  pm.expect(Number.isFinite(maxResponseMs) && maxResponseMs > 0).to.eql(true);",
          "  pm.expect(pm.response.responseTime).to.be.below(maxResponseMs);",
          "});",
          "var caseId = pm.info.requestName.match(/^TC-\\d{2}-\\d{2}[a-z]?\\b/);",
          "if (caseId) { var seen = JSON.parse(pm.collectionVariables.get('tb98ExecutedCases') || '[]'); if (seen.indexOf(caseId[0]) < 0) seen.push(caseId[0]); pm.collectionVariables.set('tb98ExecutedCases', JSON.stringify(seen)); }",
          "if (pm.request.method === 'POST' && pm.request.url.toString().split('?')[0].endsWith('/admin/ingredient-categories') && pm.response.code === 201) {",
          "  var groupData = null; try { groupData = pm.response.json(); } catch (error) {}",
          "  if (groupData && groupData.EC === 0 && groupData.DT && Number.isSafeInteger(groupData.DT.ingredientCategoryId)) {",
          "    var group = { runId: pm.collectionVariables.get('tb98RunId'), ingredientCategoryId: groupData.DT.ingredientCategoryId, categoryName: groupData.DT.categoryName };",
          "    var groups = JSON.parse(pm.collectionVariables.get('tb98RemainingGroups') || '[]'); groups.push(group); pm.collectionVariables.set('tb98RemainingGroups', JSON.stringify(groups));",
          "    console.log('QA_LEFTOVER_GROUP ' + JSON.stringify(group));",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00_Setup",
      "item": [
        {
          "name": "TC-SETUP-01 Warm-up backend và khởi tạo lượt chạy (UC-08)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Kiểm tra các biến environment có sẵn trước khi tạo dữ liệu kiểm thử.",
                  "var requiredKeys = [\"baseUrl\",\"userAEmail\",\"userPassword\",\"adminEmail\",\"adminPassword\",\"maxResponseMs\"];",
                  "var missingKeys = requiredKeys.filter(function (key) {",
                  "  var value = pm.environment.get(key);",
                  "  return value === undefined || value === null || String(value).trim() === '';",
                  "});",
                  "if (missingKeys.length > 0) {",
                  "  pm.execution.setNextRequest(null);",
                  "  throw new Error('Environment đang chọn thiếu các biến: ' + missingKeys.join(', '));",
                  "}",
                  "if (!/^https?:\\/\\/.+\\/api\\/v1$/.test(String(pm.environment.get('baseUrl')))) {",
                  "  pm.execution.setNextRequest(null);",
                  "  throw new Error('Biến baseUrl trong environment phải là URL HTTP(S), kết thúc bằng /api/v1 và không có dấu gạch chéo cuối.');",
                  "}",
                  "var maxResponseMs = Number(pm.environment.get('maxResponseMs'));",
                  "if (!Number.isFinite(maxResponseMs) || maxResponseMs <= 0) {",
                  "  pm.execution.setNextRequest(null);",
                  "  throw new Error('Biến maxResponseMs trong environment phải là số dương.');",
                  "}",
                  "",
                  "pm.collectionVariables.toObject && Object.keys(pm.collectionVariables.toObject()).forEach(function (key) {",
                  "          if (key.indexOf('tb98') === 0) pm.collectionVariables.unset(key);",
                  "        });",
                  "        pm.collectionVariables.set('tb98RunId', Date.now().toString(36) + Math.random().toString(36).slice(2, 7));",
                  "pm.variables.set('tb98ResponseLimitMs', Math.max(60000, Number(pm.environment.get('maxResponseMs'))));",
                  "pm.collectionVariables.set('tb98ExecutedCases', '[]');",
                  "pm.collectionVariables.set('tb98RemainingGroups', '[]');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = null;",
                  "try { body = pm.response.json(); } catch (error) { /* Phép kiểm tra cấu trúc sẽ báo JSON không hợp lệ. */ }",
                  "pm.test('TC-SETUP-01 Máy chủ phản hồi HTTP 200 và EC 0', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body).to.be.an('object');",
                  "  pm.expect(body.EC).to.eql(0);",
                  "});",
                  "if (pm.response.code !== 200 || !body || body.EC !== 0) pm.execution.setNextRequest(null);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/home",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "home"
              ]
            },
            "description": "Đánh thức máy chủ bằng GET /home trước khi đăng nhập. Chỉ request này được nới ngưỡng thời gian lên tối thiểu 60000 ms; các request kiểm thử vẫn dùng maxResponseMs trong environment."
          },
          "response": []
        },
        {
          "name": "TC-SETUP-02 Đăng nhập User lấy token (UC-08)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = null;",
                  "    try { body = pm.response.json(); } catch (error) { /* Phép kiểm tra cấu trúc phản hồi sẽ báo lỗi nếu JSON không hợp lệ. */ }",
                  "    pm.test('TC-SETUP-02 HTTP 200 và EC 0', function () {",
                  "      pm.response.to.have.status(200);",
                  "      pm.expect(body).to.be.an('object');",
                  "      pm.expect(body.EC).to.eql(0);",
                  "    });",
                  "    ",
                  "        var dt = body && body.DT;",
                  "        var valid = Boolean(dt && typeof dt.accessToken === 'string' && /^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/.test(dt.accessToken) && dt.user && dt.user.role === 'User' && Number.isSafeInteger(dt.user.userId) && dt.user.userId > 0);",
                  "        pm.test('Đăng nhập trả JWT hợp lệ và đúng vai trò User', function () { pm.expect(valid).to.eql(true); });",
                  "        if (pm.response.code === 200 && body && body.EC === 0 && valid) {",
                  "          pm.collectionVariables.set('tb98UserToken', dt.accessToken);",
                  "          pm.collectionVariables.set('tb98UserId', dt.user.userId);",
                  "        } else { pm.execution.setNextRequest(null); }",
                  "      ",
                  "    ",
                  "    if (pm.response.code !== 200 || !body || body.EC !== 0) { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
