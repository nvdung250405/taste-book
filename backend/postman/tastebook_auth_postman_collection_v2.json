  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response là JSON hợp lệ', function () {",
          "    pm.expect(function () { pm.response.json(); }).to.not.throw();",
          "});",
          "",
          "var jsonData = pm.response.json();",
          "",
          "pm.test('Response có đủ cấu trúc EC/EM/DT', function () {",
          "    pm.expect(jsonData).to.be.an('object');",
          "    pm.expect(jsonData).to.have.property('EC');",
          "    pm.expect(jsonData).to.have.property('EM');",
          "    pm.expect(jsonData).to.have.property('DT');",
          "});",
          "",
          "pm.test('EC đúng kiểu number', function () {",
          "    pm.expect(jsonData.EC).to.be.a('number');",
          "});",
          "",
          "pm.test('EM đúng kiểu string và không rỗng', function () {",
          "    pm.expect(jsonData.EM).to.be.a('string');",
          "    pm.expect(jsonData.EM.trim()).to.not.eql('');",
          "});",
          "",
          "pm.test('DT đúng kiểu null/object/array', function () {",
          "    pm.expect(jsonData.DT === null || typeof jsonData.DT === 'object').to.eql(true);",
          "});",
          "",
          "pm.test('EC phù hợp với HTTP Status theo đặc tả', function () {",
          "    var expectedByStatus = {",
          "        200: [0],",
          "        201: [0],",
          "        400: [1],",
          "        401: [5, 6],",
          "        403: [4],",
          "        404: [3],",
          "        409: [2],",
          "        500: [-1]",
          "    };",
          "    if (Object.prototype.hasOwnProperty.call(expectedByStatus, pm.response.code)) {",
          "        pm.expect(expectedByStatus[pm.response.code]).to.include(jsonData.EC);",
          "    }",
          "});",
          "",
          "pm.test('Response lỗi 4xx/5xx phải có DT = null', function () {",
          "    if (pm.response.code >= 400) {",
          "        pm.expect(jsonData.DT).to.eql(null);",
          "    }",
          "});"
        ]
      }
    }
  ]
